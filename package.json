{
  "name": "javalint",
  "version": "0.2.1",
  "description": "Java static code analysis powered by CodeGraph",
  "main": "dist/index.js",
  "bin": {
    "javalint": "./dist/bin/javalint.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const d='dist/analyzer';fs.mkdirSync(d,{recursive:true});['jdk-api-index.json','jdk-api-index.db','tree-sitter-java.wasm'].forEach(f=>{const s=p.join('src/analyzer',f);if(fs.existsSync(s))fs.copyFileSync(s,p.join(d,f))})\"",
    "dev": "tsc --watch",
    "cli": "npm run build && node dist/bin/javalint.js",
    "test": "node dist/bin/javalint.js analyze"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "^0.9.3",
    "commander": "^12.1.0",
    "web-tree-sitter": "^0.25.10",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
